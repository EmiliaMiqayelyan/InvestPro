NODE_ENV=development
PORT=4000

# mysql (default) or sqlite
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=investpro
DB_USER=invest
DB_PASSWORD=invest
# For sqlite local/dev verification:
# DB_DIALECT=sqlite
# DB_STORAGE=./dev.sqlite
# DB_STORAGE=:memory:

JWT_SECRET=investpro-dev-secret-change-in-production
CORS_ORIGIN=http://localhost:3000

# Brevo transactional email (preferred for verification / password reset)
# Create key: Brevo → Settings → SMTP & API → API keys
BREVO_API_KEY=
# Must be a verified sender in Brevo (email or Name <email>)
BREVO_SENDER_EMAIL="XS Invest <noreply@xsinvest.org>"

# Optional SMTP fallback (not needed when Brevo API key is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="XS Invest <noreply@xsinvest.org>"

STRIPE_SECRET_KEY=
STRIPE_SERVICE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Sync schema on boot (handy for sqlite/dev). Prefer migrations in production.
DB_SYNC=false
LOG_LEVEL=info
