NODE_ENV=development
PORT=4000

# mysql (default) or sqlite
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=investpro
DB_USER=invest
DB_PASSWORD=invest
# For sqlite local/dev verification:
# DB_DIALECT=sqlite
# DB_STORAGE=./dev.sqlite
# DB_STORAGE=:memory:

JWT_SECRET=investpro-dev-secret-change-in-production
CORS_ORIGIN=http://localhost:3000

# Optional integrations
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

STRIPE_SECRET_KEY=
STRIPE_SERVICE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Sync schema on boot (handy for sqlite/dev). Prefer migrations in production.
DB_SYNC=false
LOG_LEVEL=info
