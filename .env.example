# Database (Phase 5 — set when moving off in-memory store)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/investpro?schema=public"

# Auth
JWT_SECRET="investpro-dev-secret-change-in-production"

# API (leave empty to use Next.js /api/v1 mock)
NEXT_PUBLIC_API_URL=

# Stripe platform service fee (optional until live payments)
STRIPE_SECRET_KEY=
