# ─── Vercel / Production ───────────────────────────────────────────
# Required: use the built-in API on the same deployment
NEXT_PUBLIC_API_URL=/api/v1

# Required on Vercel: set a strong random secret (Settings → Environment Variables)
JWT_SECRET=your-strong-random-secret-here

# ─── External backend (optional) ───────────────────────────────────
# When your real REST API is ready, point to it instead:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
