# File storage (optional — mock /uploads used until configured)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Email (optional)
SMTP_HOST=
SMTP_PORT=
