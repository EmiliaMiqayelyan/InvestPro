# Local / production Next.js env (copy to .env — do not commit secrets)

NODE_ENV=production
PORT=3926
# Listen address is fixed in web-server.cjs (127.0.0.1). Do not set Next's
# hostname to 127.0.0.1 — middleware redirects then point at localhost.

# Express API (PM2 investpro-api)
BACKEND_URL=http://127.0.0.1:4926

# Host visitors use. The site redirects localhost to this host, and the
# browser calls the API on the same host (port NEXT_PUBLIC_API_PORT).
NEXT_PUBLIC_PUBLIC_HOST=192.168.15.2
NEXT_PUBLIC_API_PORT=4000
# Optional absolute API origin. Leave unset to use PUBLIC_HOST + API_PORT.
# Do not set this to localhost — page links would leave the public site.
# NEXT_PUBLIC_API_URL=http://192.168.15.2:4000/api/v1

# MUST match server/.env JWT_SECRET (Next middleware verifies access_token cookie)
JWT_SECRET=change-me-to-match-server-env
