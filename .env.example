# Local / production Next.js env (copy to .env — do not commit secrets)

NODE_ENV=production
PORT=3926
# Do not set HOSTNAME. Next would build links from that bind address.

# Express API (PM2 investpro-api). Browser calls stay on /api/v1.
BACKEND_URL=http://127.0.0.1:4926

# Public site host. Redirects and absolute links use this, never localhost.
NEXT_PUBLIC_PUBLIC_HOST=xsinvest.org
NEXT_PUBLIC_API_URL=/api/v1

# MUST match server/.env JWT_SECRET (Next middleware verifies access_token cookie)
JWT_SECRET=change-me-to-match-server-env
